#!/bin/sh
# Block commits that contain a Groq key (gsk_...). Run: uv run setup/info_buddy_lab.py --scrub
if git diff --cached -U0 | grep -E '^\+.*gsk_[A-Za-z0-9]{10,}' >/dev/null; then
  echo "BLOCKED: a Groq API key (gsk_...) is staged. Run: uv run setup/info_buddy_lab.py --scrub, then re-stage." >&2
  exit 1
fi
